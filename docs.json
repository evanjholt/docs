{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NorthAxium Data",
  "description": "Developer documentation for the NorthAxium Data API, guides, and MCP server.",
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/logo/TransparentFullLogo.png",
    "dark": "/logo/DarkModeTransparentFullLogo.png"
  },
  "favicon": "/logo/favicon-rounded.png",
  "colors": {
    "primary": "#26231D",
    "light": "#EDE8DF",
    "dark": "#26231D"
  },
  "background": {
    "color": {
      "light": "#F7F6F3",
      "dark": "#16130F"
    }
  },
  "api": {
    "mdx": {
      "server": "https://api.northaxiumdata.ca",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://northaxiumdata.ca"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "introduction",
          "quickstart",
          "authentication",
          "data-sources",
          "data-coverage",
          "model-context-protocol",
          "openapi-spec",
          "support"
        ]
      },
      {
        "group": "APIs",
        "pages": [
          {
            "group": "Contracts",
            "icon": "file-contract",
            "pages": [
              "api-reference/contracts/list",
              "api-reference/contracts/stats",
              "api-reference/contracts/disclosures",
              "api-reference/contracts/lifecycle"
            ]
          },
          {
            "group": "Vendors",
            "icon": "building",
            "pages": [
              "api-reference/vendors/list",
              "api-reference/vendors/profile"
            ]
          },
          {
            "group": "Departments",
            "icon": "landmark",
            "pages": [
              "api-reference/departments/list",
              "api-reference/departments/profile"
            ]
          },
          {
            "group": "Grants",
            "icon": "hand-holding-dollar",
            "pages": [
              "api-reference/grants/federal",
              "api-reference/grants/research",
              "api-reference/grants/infrastructure",
              "api-reference/grants/recipients"
            ]
          },
          {
            "group": "Lobbying",
            "icon": "comment-dots",
            "pages": [
              "api-reference/lobbying/communications",
              "api-reference/lobbying/registrations",
              "api-reference/lobbying/profiles"
            ]
          },
          {
            "group": "Contributions",
            "icon": "circle-dollar-to-slot",
            "pages": [
              "api-reference/contributions/list",
              "api-reference/contributions/profiles"
            ]
          },
          {
            "group": "Parliamentary",
            "icon": "building-columns",
            "pages": [
              "api-reference/parliamentary/bills",
              "api-reference/parliamentary/politicians",
              "api-reference/parliamentary/committees"
            ]
          },
          {
            "group": "Permits",
            "icon": "clipboard-check",
            "pages": [
              "api-reference/permits/list"
            ]
          },
          {
            "group": "Discovery",
            "icon": "magnifying-glass",
            "pages": [
              "api-reference/search"
            ]
          }
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/search-contracts",
          "guides/find-lobbying-activity",
          "guides/track-contributions"
        ]
      }
    ]
  }
}
